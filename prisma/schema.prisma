// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {

  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  password  String
  position  String?
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  tasks     Tasks[]
  jobs    Jobs[]
  invoice  Invoice[]
}

model Company {
  id                String  @id @default(uuid())
  companyName       String
  companyImageLarge String?
  companyImageSmall String?
  email   String
  phoneNumber  String
  sortCode  String?
  accountNumber  String?
  accountName  String?
  users             User[]
  tasks             Tasks[]
 
}

model Tasks {
  id           String         @id @default(uuid())
  title        String
  description  String[]
  privateDescription  String?
  pricePerUnit Decimal        @db.Decimal(6, 2)
  category     String
  jobs         JobTasks[]
  invoices     InvoiceTasks[]
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  company      Company?       @relation(fields: [companyId], references: [id])
  companyId    String?
}

model Jobs {
  id       String        @id @default(uuid())
  name     String
  street  String[]
  town  String[]
  postcode  String
  tasks    JobTasks[]
  invoices InvoiceJobs[]
   user         User?          @relation(fields: [userId], references: [id])
  userId       String?
 
}

model Invoice {
  id            String         @id @default(uuid())
  invoiceNumber  String
  dateCreated   DateTime       @default(now())
  jobs          InvoiceJobs[]
  tasks         InvoiceTasks[]
   user         User?          @relation(fields: [userId], references: [id])
  userId       String?
}

model JobTasks {
  job   Jobs   @relation(fields: [jobId], references: [id])
  jobId String

  task   Tasks  @relation(fields: [taskId], references: [id])
  taskId String

  @@id([jobId, taskId])
}

model InvoiceJobs {
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String

  job   Jobs   @relation(fields: [jobId], references: [id])
  jobId String
  

  @@id([invoiceId, jobId])
}

model InvoiceTasks {
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String

  task   Tasks  @relation(fields: [taskId], references: [id])
  taskId String
quantity  Int?  @default(1)
  @@id([invoiceId, taskId])
}
