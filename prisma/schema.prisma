// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Users {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  password  String
  position  String?
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  tasks     Tasks[]
}

model Company {
  id                String  @id @default(uuid())
  companyName       String
  companyImageLarge String?
  companyImageSmall String?
  users             Users[]
  tasks             Tasks[]
}

model Tasks {
  id           String         @id @default(uuid())
  title        String
  description  String
  pricePerUnit Decimal        @db.Decimal(6, 2)
  category     String
  jobs         JobTasks[]
  invoices     InvoiceTasks[]
  user         Users          @relation(fields: [userId], references: [id])
  userId       String
  company      Company?       @relation(fields: [companyId], references: [id])
  companyId    String?
}

model Jobs {
  id       String        @id @default(uuid())
  name     String
  address  String?
  jobStart DateTime?
  endDate  DateTime?
  status   String?
  tasks    JobTasks[]
  invoices InvoiceJobs[]
}

model Invoice {
  id            String         @id @default(uuid())
  invoiceNumber  DateTime       @default(now())
  dateCreated   DateTime       @default(now())
  jobs          InvoiceJobs[]
  tasks         InvoiceTasks[]
}

model JobTasks {
  job   Jobs   @relation(fields: [jobId], references: [id])
  jobId String

  task   Tasks  @relation(fields: [taskId], references: [id])
  taskId String

  @@id([jobId, taskId])
}

model InvoiceJobs {
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String

  job   Jobs   @relation(fields: [jobId], references: [id])
  jobId String

  @@id([invoiceId, jobId])
}

model InvoiceTasks {
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId String

  task   Tasks  @relation(fields: [taskId], references: [id])
  taskId String

  @@id([invoiceId, taskId])
}
